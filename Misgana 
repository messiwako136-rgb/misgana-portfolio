* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f0f4f8;
    color: #222;
    line-height: 1.6;
}

header {
    background: #071b3a;
    color: white;
    text-align: center;
    padding: 50px 20px;
}

header h1 {
    font-size: 35px;
}

section {
    background: white;
    margin: 20px;
    padding: 25px;
    border-radius: 12px;
}

h2 {
    color: #0756a5;
    margin-bottom: 12px;
}

footer {
    background: #071b3a;
    color: white;
    text-align: center;
    padding: 20px;
}